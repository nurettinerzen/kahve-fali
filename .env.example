# Bu dosyayı ".env" adıyla kopyala ve kendi anahtarlarını yapıştır.
# .env dosyasını asla paylaşma / commit etme (.gitignore'da).

ANTHROPIC_API_KEY=sk-ant-buraya-kendi-anahtarin
ELEVENLABS_API_KEY=sk_buraya-yeni-eleven-anahtarin

# İsteğe bağlı — varsayılan Ayşe Teyze sesi zaten kodda:
# ELEVENLABS_VOICE_ID=wGcFBfKz5yUQqhqr0mVy
# PORT=8788

# --- uygulama anahtarı (istemcideki APP_KEY ile aynı olmalı) ---
APP_KEY=

# --- jeton defteri (Supabase) ---
# Bu ikisi yoksa sunucu ESKİ davranışa düşer: jeton yalnızca istemcide sayılır.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=service_role_anahtari

# --- satın alma doğrulaması ---
# RevenueCat > Project settings > API keys > Secret key (sk_... — "appl_" ile başlayan
# istemci anahtarı DEĞİL). Yoksa /api/satinalma 503 döner ve jeton yüklenmez.
RC_SECRET=sk_...

# Apple kimlik jetonu doğrulaması için beklenen aud (uygulamanın bundle id'si)
APPLE_CLIENT_ID=com.nurettinerzen.kahvefali

# CORS. Boş bırakılırsa yalnızca native WebView origin'lerine izin verilir (önerilen).
# ALLOWED_ORIGIN=https://ornek.com

# GEÇİCİ: mağazadaki ESKİ sürüm /api/hesap-sil'e kimlik jetonu göndermiyor.
# Yeni istemci sürümü yayına girene kadar "1", sonra bu satırı KALDIR (IDOR ancak o zaman kapanır).
# HESAPSIL_ESKI_ISTEMCI=1
